{
  "id": "/",
  "name": "Artisan Connect",
  "short_name": "ArtisanConnect",
  "description": "AI-assisted marketplace connecting artisans with buyers.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
